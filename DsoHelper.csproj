<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>DsoHelper</RootNamespace>
    <AssemblyName>DsoHelper</AssemblyName>
    <Version>1.5.1</Version>
    <AssemblyVersion>1.5.1</AssemblyVersion>
    <FileVersion>1.5.1</FileVersion>
    <Description>Drakensang Online helper: fast mount, inventory check, auto-sell, auto-melt</Description>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <!-- Исходный PNG (1024 px) нужен только для пересборки иконки: в exe ему не место. -->
    <AvaloniaResource Remove="Assets\app.png" />
    <!-- Исходник логотипа в шапке (масштабируется в header-icon.png), в сборку не нужен:
         Avalonia не умеет отрисовывать SVG без отдельной библиотеки. -->
    <AvaloniaResource Remove="Assets\header-icon.svg" />
  </ItemGroup>

  <ItemGroup>
    <TrimmerRootDescriptor Include="trimmer-root.xml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Material.Icons.Avalonia" Version="3.0.2" />
  </ItemGroup>
</Project>

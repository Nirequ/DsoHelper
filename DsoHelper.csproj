<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>DsoHelper</RootNamespace>
    <AssemblyName>DsoHelper</AssemblyName>
    <Version>1.4.8</Version>
    <AssemblyVersion>1.4.8</AssemblyVersion>
    <FileVersion>1.4.8</FileVersion>
    <Description>Fast Mount helper for Drakensang Online</Description>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <!-- Р ВРЎРѓРЎвЂ¦Р С•Р Т‘Р Р…РЎвЂ№Р в„– PNG (1024 px) Р Р…РЎС“Р В¶Р ВµР Р… РЎвЂљР С•Р В»РЎРЉР С”Р С• Р Т‘Р В»РЎРЏ Р С—Р ВµРЎР‚Р ВµРЎРѓР В±Р С•РЎР‚Р С”Р С‘ Р С‘Р С”Р С•Р Р…Р С”Р С‘: Р Р† exe Р ВµР СРЎС“ Р Р…Р Вµ Р СР ВµРЎРѓРЎвЂљР С•. -->
    <AvaloniaResource Remove="Assets\app.png" />
  </ItemGroup>

  <ItemGroup>
    <TrimmerRootDescriptor Include="trimmer-root.xml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>
</Project>

<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Design tokens for DSO Helper — "Drakensang" system.
        Parchment-brown surfaces, old-gold accents, crimson primary buttons, ivory text.
    -->

    <!-- Surfaces -->
    <Color x:Key="AppBackgroundColor">#FF171411</Color>
    <Color x:Key="HeaderSurfaceColor">#FF1A1714</Color>
    <Color x:Key="CardSurfaceColor">#FF201C18</Color>
    <Color x:Key="SunkenSurfaceColor">#FF28231F</Color>
    <Color x:Key="ChipSurfaceColor">#FF28231F</Color>
    <Color x:Key="TabActiveSurfaceColor">#FF29241B</Color>
    <Color x:Key="BorderColor">#FF3B342E</Color>

    <!-- Interaction steps derived from the surface scale -->
    <Color x:Key="SurfaceHoverColor">#FF302A24</Color>
    <Color x:Key="SurfacePressedColor">#FF221D19</Color>
    <Color x:Key="BorderHoverColor">#FF4A423A</Color>

    <!-- Accent: crimson (primary actions) -->
    <Color x:Key="CrimsonColor">#FF942832</Color>
    <Color x:Key="CrimsonHoverColor">#FFA63641</Color>
    <Color x:Key="CrimsonPressedColor">#FF7C2029</Color>
    <Color x:Key="OnCrimsonTextColor">#FFEEE4D1</Color>

    <!-- Accent: old gold -->
    <Color x:Key="GoldColor">#FFC59B53</Color>
    <Color x:Key="GoldLightColor">#FFC5984B</Color>
    <Color x:Key="GoldTintColor">#33C59B53</Color>
    <Color x:Key="GoldOnTextColor">#FF171411</Color>
    <Color x:Key="GoldBorderColor">#FF795D2E</Color>

    <!-- Text -->
    <Color x:Key="TextPrimaryColor">#FFF7F0DD</Color>
    <Color x:Key="TextSecondaryColor">#FFB1AC9E</Color>
    <Color x:Key="TextMutedColor">#FF807C72</Color>

    <!-- State -->
    <Color x:Key="SuccessColor">#FF76BE9B</Color>
    <Color x:Key="SuccessSurfaceColor">#FF1E2A24</Color>
    <Color x:Key="ErrorColor">#FFD97065</Color>
    <Color x:Key="WarningSurfaceColor">#FF2A2319</Color>

    <!-- Brushes: surfaces -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="HeaderSurfaceBrush" Color="{StaticResource HeaderSurfaceColor}" />
    <SolidColorBrush x:Key="CardSurfaceBrush" Color="{StaticResource CardSurfaceColor}" />
    <SolidColorBrush x:Key="SunkenSurfaceBrush" Color="{StaticResource SunkenSurfaceColor}" />
    <SolidColorBrush x:Key="ChipSurfaceBrush" Color="{StaticResource ChipSurfaceColor}" />
    <SolidColorBrush x:Key="TabActiveSurfaceBrush" Color="{StaticResource TabActiveSurfaceColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />

    <!-- Brushes: interaction steps -->
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="{StaticResource SurfacePressedColor}" />
    <SolidColorBrush x:Key="BorderHoverBrush" Color="{StaticResource BorderHoverColor}" />

    <!-- Brushes: crimson -->
    <SolidColorBrush x:Key="CrimsonBrush" Color="{StaticResource CrimsonColor}" />
    <SolidColorBrush x:Key="CrimsonHoverBrush" Color="{StaticResource CrimsonHoverColor}" />
    <SolidColorBrush x:Key="CrimsonPressedBrush" Color="{StaticResource CrimsonPressedColor}" />
    <SolidColorBrush x:Key="OnCrimsonTextBrush" Color="{StaticResource OnCrimsonTextColor}" />

    <!-- Brushes: brand -->
    <SolidColorBrush x:Key="GoldBrush" Color="{StaticResource GoldColor}" />
    <SolidColorBrush x:Key="GoldLightBrush" Color="{StaticResource GoldLightColor}" />
    <SolidColorBrush x:Key="GoldTintBrush" Color="{StaticResource GoldTintColor}" />
    <SolidColorBrush x:Key="GoldOnTextBrush" Color="{StaticResource GoldOnTextColor}" />
    <SolidColorBrush x:Key="GoldBorderBrush" Color="{StaticResource GoldBorderColor}" />

    <!-- Brushes: text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />

    <!-- Rarity scale for the inventory grid — цвета из клиента DSO.
         Common #CFCFCF · Uncommon #28ED00 · Magic #0078FF · Rare #FF17FF ·
         Epic #FF6C00 · Unique #FFDB11 · Set #00AEDA · Mythic #BD1F00 -->
    <Color x:Key="RarityCommonColor">#FFCFCFCF</Color>
    <Color x:Key="RarityImprovedColor">#FF28ED00</Color>
    <Color x:Key="RarityMagicColor">#FF0078FF</Color>
    <Color x:Key="RarityExtraordinaryColor">#FFFF17FF</Color>
    <Color x:Key="RarityLegendaryColor">#FFFF6C00</Color>
    <Color x:Key="RarityUniqueColor">#FFFFDB11</Color>
    <!-- Сетовые предметы: цвет есть в клиенте, чекер пока не выделяет их отдельной редкостью. -->
    <Color x:Key="RaritySetColor">#FF00AEDA</Color>
    <Color x:Key="RarityMythicColor">#FFBD1F00</Color>

    <!-- Brushes: state -->
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessSurfaceBrush" Color="{StaticResource SuccessSurfaceColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="WarningSurfaceBrush" Color="{StaticResource WarningSurfaceColor}" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="{StaticResource GoldLightColor}" />

    <!-- Brushes: rarity scale -->
    <SolidColorBrush x:Key="RarityCommonBrush" Color="{StaticResource RarityCommonColor}" />
    <SolidColorBrush x:Key="RarityImprovedBrush" Color="{StaticResource RarityImprovedColor}" />
    <SolidColorBrush x:Key="RarityMagicBrush" Color="{StaticResource RarityMagicColor}" />
    <SolidColorBrush x:Key="RarityExtraordinaryBrush" Color="{StaticResource RarityExtraordinaryColor}" />
    <SolidColorBrush x:Key="RarityLegendaryBrush" Color="{StaticResource RarityLegendaryColor}" />
    <SolidColorBrush x:Key="RarityUniqueBrush" Color="{StaticResource RarityUniqueColor}" />
    <SolidColorBrush x:Key="RarityMythicBrush" Color="{StaticResource RarityMythicColor}" />
    <SolidColorBrush x:Key="RaritySetBrush" Color="{StaticResource RaritySetColor}" />

    <!-- Brushes: legacy aliases still referenced by SlotPickerWindow -->
    <SolidColorBrush x:Key="AncientGoldBrush" Color="{StaticResource GoldColor}" />
    <SolidColorBrush x:Key="AncientGoldBorderFaintBrush" Color="#66C59B53" />
    <SolidColorBrush x:Key="AncientGoldTintBrush" Color="#33C59B53" />
    <SolidColorBrush x:Key="ElevatedSurfaceBrush" Color="{StaticResource ChipSurfaceColor}" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="WindowBackdropBrush" Color="{StaticResource AppBackgroundColor}" />

    <!-- Typography -->
    <FontFamily x:Key="UiFont">avares://DsoHelper/Assets/Fonts#Inter</FontFamily>
    <FontFamily x:Key="BodyFont">avares://DsoHelper/Assets/Fonts#Inter</FontFamily>
    <FontFamily x:Key="DisplayFont">avares://DsoHelper/Assets/Fonts#Inter</FontFamily>

    <!-- Accent for Fluent built-in controls (sliders, focus rings, selection) -->
    <Color x:Key="SystemAccentColor">#FFC59B53</Color>
    <Color x:Key="SystemAccentColorLight1">#FFC5984B</Color>
    <Color x:Key="SystemAccentColorLight2">#FFD5AC67</Color>
    <Color x:Key="SystemAccentColorLight3">#FFE4C48D</Color>
    <Color x:Key="SystemAccentColorDark1">#FFA87F3F</Color>
    <Color x:Key="SystemAccentColorDark2">#FF8A6531</Color>
    <Color x:Key="SystemAccentColorDark3">#FF6B4E27</Color>

    <SolidColorBrush x:Key="SystemAccentColorBrush" Color="{StaticResource GoldColor}" />
    <SolidColorBrush x:Key="SystemControlBackgroundAccentBrush" Color="{StaticResource GoldColor}" />
    <SolidColorBrush x:Key="SystemControlForegroundAccentBrush" Color="{StaticResource GoldColor}" />
    <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="{StaticResource GoldColor}" />

    <!-- Fluent slider parts -->
    <SolidColorBrush x:Key="SliderTrackFill" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="{StaticResource BorderHoverColor}" />
    <SolidColorBrush x:Key="SliderTrackFillPressed" Color="{StaticResource BorderHoverColor}" />
    <SolidColorBrush x:Key="SliderTrackFillDisabled" Color="#FF2A251F" />
    <SolidColorBrush x:Key="SliderTrackValueFill" Color="{StaticResource GoldColor}" />
    <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="{StaticResource GoldLightColor}" />
    <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="{StaticResource GoldLightColor}" />
    <SolidColorBrush x:Key="SliderTrackValueFillDisabled" Color="#FF5A4A2A" />
    <SolidColorBrush x:Key="SliderThumbBackground" Color="{StaticResource GoldColor}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="{StaticResource GoldLightColor}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="{StaticResource GoldLightColor}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundDisabled" Color="#FF5A4A2A" />

    <!-- Fluent scrollbars: thin parchment rail -->
    <SolidColorBrush x:Key="ScrollBarPanningThumbBackground" Color="#4D807C72" />
    <SolidColorBrush x:Key="ScrollBarThumbFill" Color="#4D807C72" />
    <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#80807C72" />
    <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="#A6807C72" />
    <SolidColorBrush x:Key="ScrollBarThumbBackgroundColor" Color="#4D807C72" />
    <SolidColorBrush x:Key="ScrollBarBackground" Color="Transparent" />
    <SolidColorBrush x:Key="ScrollBarTrackFill" Color="Transparent" />
    <SolidColorBrush x:Key="ScrollBarTrackStroke" Color="Transparent" />
    <SolidColorBrush x:Key="ScrollBarBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ScrollBarForeground" Color="{StaticResource TextMutedColor}" />

</ResourceDictionary>

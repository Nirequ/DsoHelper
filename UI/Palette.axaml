<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Dark fantasy palette for DSO Helper.
        Source: drakensang_helper_color_palette.md
    -->

    <!-- Backgrounds & surfaces -->
    <Color x:Key="ObsidianBlackColor">#121316</Color>
    <Color x:Key="DeepDungeonColor">#1A1C23</Color>
    <Color x:Key="ElevatedSurfaceColor">#242834</Color>
    <Color x:Key="BorderColor">#373C4A</Color>

    <!-- Brand & accents -->
    <Color x:Key="AncientGoldColor">#E0A93B</Color>
    <Color x:Key="CrimsonRedColor">#C93B3B</Color>
    <Color x:Key="MysticArcaneColor">#8A5CF5</Color>
    <Color x:Key="EssenceCyanColor">#2CB67D</Color>

    <!-- Text -->
    <Color x:Key="TextPrimaryColor">#E6E8EC</Color>
    <Color x:Key="TextSecondaryColor">#8C93A2</Color>
    <Color x:Key="TextDisabledColor">#525866</Color>

    <!-- Item rarity colors (DSO canonical) -->
    <Color x:Key="RarityBasicColor">#B0B3B8</Color>
    <Color x:Key="RarityImprovedColor">#3B82F6</Color>
    <Color x:Key="RarityExtraordinaryColor">#A855F7</Color>
    <Color x:Key="RarityLegendaryColor">#F97316</Color>
    <Color x:Key="RarityUniqueColor">#EAB308</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="ObsidianBlackBrush" Color="{StaticResource ObsidianBlackColor}" />
    <SolidColorBrush x:Key="DeepDungeonBrush" Color="{StaticResource DeepDungeonColor}" />
    <SolidColorBrush x:Key="ElevatedSurfaceBrush" Color="{StaticResource ElevatedSurfaceColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />

    <SolidColorBrush x:Key="AncientGoldBrush" Color="{StaticResource AncientGoldColor}" />
    <SolidColorBrush x:Key="CrimsonRedBrush" Color="{StaticResource CrimsonRedColor}" />
    <SolidColorBrush x:Key="MysticArcaneBrush" Color="{StaticResource MysticArcaneColor}" />
    <SolidColorBrush x:Key="EssenceCyanBrush" Color="{StaticResource EssenceCyanColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}" />

    <SolidColorBrush x:Key="RarityBasicBrush" Color="{StaticResource RarityBasicColor}" />
    <SolidColorBrush x:Key="RarityImprovedBrush" Color="{StaticResource RarityImprovedColor}" />
    <SolidColorBrush x:Key="RarityExtraordinaryBrush" Color="{StaticResource RarityExtraordinaryColor}" />
    <SolidColorBrush x:Key="RarityLegendaryBrush" Color="{StaticResource RarityLegendaryColor}" />
    <SolidColorBrush x:Key="RarityUniqueBrush" Color="{StaticResource RarityUniqueColor}" />

    <!-- Additional medieval framing tones -->
    <SolidColorBrush x:Key="ObsidianDeepBrush" Color="#0E0F12" />
    <SolidColorBrush x:Key="CardInnerBorderBrush" Color="#2B303D" />
    <SolidColorBrush x:Key="AncientGoldLightBrush" Color="#F2C15E" />
    <SolidColorBrush x:Key="AncientGoldDarkBrush" Color="#C98E2B" />

    <!-- Translucent tints for glows and accent fills -->
    <SolidColorBrush x:Key="AncientGoldTintBrush" Color="#33E0A93B" />
    <SolidColorBrush x:Key="AncientGoldFaintBrush" Color="#1FE0A93B" />
    <SolidColorBrush x:Key="MysticArcaneTintBrush" Color="#338A5CF5" />
    <SolidColorBrush x:Key="EssenceCyanTintBrush" Color="#332CB67D" />
    <SolidColorBrush x:Key="CrimsonRedTintBrush" Color="#33C93B3B" />
    <SolidColorBrush x:Key="AncientGoldBorderFaintBrush" Color="#66E0A93B" />

    <!-- Typography: both fonts include Cyrillic -->
    <FontFamily x:Key="DisplayFont">avares://DsoHelper/Assets/Fonts#Forum</FontFamily>
    <FontFamily x:Key="BodyFont">avares://DsoHelper/Assets/Fonts#PT Serif</FontFamily>

    <!-- Gradients -->
    <LinearGradientBrush x:Key="WindowBackdropBrush" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="#1A1C23" Offset="0" />
        <GradientStop Color="#121316" Offset="0.55" />
        <GradientStop Color="#0E0F12" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GoldButtonBrush" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="#F2C15E" Offset="0" />
        <GradientStop Color="#E0A93B" Offset="0.55" />
        <GradientStop Color="#C98E2B" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="RaritySpectrumBrush" StartPoint="0%,0%" EndPoint="100%,0%">
        <GradientStop Color="#B0B3B8" Offset="0" />
        <GradientStop Color="#3B82F6" Offset="0.25" />
        <GradientStop Color="#A855F7" Offset="0.5" />
        <GradientStop Color="#F97316" Offset="0.75" />
        <GradientStop Color="#EAB308" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GoldRuleLeftBrush" StartPoint="0%,0%" EndPoint="100%,0%">
        <GradientStop Color="#00E0A93B" Offset="0" />
        <GradientStop Color="#99E0A93B" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GoldRuleRightBrush" StartPoint="0%,0%" EndPoint="100%,0%">
        <GradientStop Color="#99E0A93B" Offset="0" />
        <GradientStop Color="#00E0A93B" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HeaderGlowBrush" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#24E0A93B" Offset="0" />
        <GradientStop Color="#00E0A93B" Offset="1" />
    </LinearGradientBrush>

    <!-- Let Fluent controls (checkboxes, focus rings, selection) use the gold accent -->
    <Color x:Key="SystemAccentColor">#E0A93B</Color>
    <Color x:Key="SystemAccentColorLight1">#F0BA55</Color>
    <Color x:Key="SystemAccentColorLight2">#F6CC7A</Color>
    <Color x:Key="SystemAccentColorLight3">#FBE0A6</Color>
    <Color x:Key="SystemAccentColorDark1">#C98E2B</Color>
    <Color x:Key="SystemAccentColorDark2">#A9741F</Color>
    <Color x:Key="SystemAccentColorDark3">#875A14</Color>

    <SolidColorBrush x:Key="SystemAccentColorBrush" Color="{StaticResource AncientGoldColor}" />
    <SolidColorBrush x:Key="SystemControlBackgroundAccentBrush" Color="{StaticResource AncientGoldColor}" />
    <SolidColorBrush x:Key="SystemControlForegroundAccentBrush" Color="{StaticResource AncientGoldColor}" />
    <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="{StaticResource AncientGoldColor}" />

    <!-- Fluent scrollbars recolored to look like a gilded rail -->
    <SolidColorBrush x:Key="ScrollBarPanningThumbBackground" Color="#4DE0A93B" />
    <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#99E0A93B" />
    <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="#E0A93B" />
    <SolidColorBrush x:Key="ScrollBarThumbBackgroundColor" Color="#66E0A93B" />
    <SolidColorBrush x:Key="ScrollBarBackground" Color="Transparent" />
    <SolidColorBrush x:Key="ScrollBarTrackFill" Color="#14151A" />
    <SolidColorBrush x:Key="ScrollBarTrackStroke" Color="#373C4A" />
    <SolidColorBrush x:Key="ScrollBarBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ScrollBarForeground" Color="{StaticResource TextSecondaryColor}" />

</ResourceDictionary>

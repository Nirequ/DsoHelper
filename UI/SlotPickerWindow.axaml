<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialIcons="using:Material.Icons.Avalonia"
        x:Class="DsoHelper.UI.SlotPickerWindow"
        Title="Выбор слота"
        Width="64"
        Height="64"
        WindowDecorations="None"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Background="Transparent"
        TransparencyLevelHint="Transparent">
    <Border Background="#CC171411"
            BorderBrush="{StaticResource GoldBrush}"
            BorderThickness="2"
            CornerRadius="8"
            BoxShadow="0 0 18 0 #59C59B53"
            Cursor="Cross">
        <Grid>
            <Border Margin="5"
                    CornerRadius="4"
                    BorderBrush="{StaticResource GoldBorderBrush}"
                    BorderThickness="1" />

            <Path Data="M4,0 L8,4 L4,8 L0,4 Z" Width="5" Height="5" Stretch="Fill"
                  Fill="{StaticResource GoldBrush}"
                  HorizontalAlignment="Left" VerticalAlignment="Top" Margin="3" />
            <Path Data="M4,0 L8,4 L4,8 L0,4 Z" Width="5" Height="5" Stretch="Fill"
                  Fill="{StaticResource GoldBrush}"
                  HorizontalAlignment="Right" VerticalAlignment="Top" Margin="3" />
            <Path Data="M4,0 L8,4 L4,8 L0,4 Z" Width="5" Height="5" Stretch="Fill"
                  Fill="{StaticResource GoldBrush}"
                  HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="3" />
            <Path Data="M4,0 L8,4 L4,8 L0,4 Z" Width="5" Height="5" Stretch="Fill"
                  Fill="{StaticResource GoldBrush}"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="3" />

            <TextBlock x:Name="HintText"
                       Text="+"
                       FontFamily="{StaticResource UiFont}"
                       FontSize="20"
                       Opacity="0.95"
                       Foreground="{StaticResource GoldBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Grid>
    </Border>
</Window>

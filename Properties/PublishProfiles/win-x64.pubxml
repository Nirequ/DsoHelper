<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <PublishDir>dist\win-x64\</PublishDir>
  </PropertyGroup>

  <!-- Не тащим .pdb в папку для раздачи: нужен только exe. -->
  <Target Name="RemovePublishPdbs" AfterTargets="Publish">
    <ItemGroup>
      <PublishPdbsToDelete Include="$(PublishDir)**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(PublishPdbsToDelete)" />
  </Target>
</Project>

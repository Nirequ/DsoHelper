<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="800"
        x:Class="DsoHelper.MainWindow"
        Title="DSO Helper"
        Icon="/Assets/app.ico"
        Width="560"
        Height="720"
        MinWidth="520"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="BorderOnly"
        CanResize="False"
        Opacity="0.9"
        Background="{StaticResource WindowBackdropBrush}">

    <Window.Styles>
        <!-- Typography -->
        <Style Selector="TextBlock.h1">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="31" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="LetterSpacing" Value="1.4" />
        </Style>
        <Style Selector="TextBlock.eyebrow">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{StaticResource AncientGoldBrush}" />
            <Setter Property="LetterSpacing" Value="2.2" />
        </Style>
        <Style Selector="TextBlock.subtitle">
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        </Style>
        <Style Selector="TextBlock.chapterTitle">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="LetterSpacing" Value="1.2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.subheading">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="LetterSpacing" Value="1.6" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.axis">
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Frames and plaques -->
        <Style Selector="Border.cardFrame">
            <Setter Property="Background" Value="{StaticResource ObsidianBlackBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="BoxShadow" Value="0 16 34 0 #5A000000" />
        </Style>
        <Style Selector="Border.cardInner">
            <Setter Property="Background" Value="{StaticResource DeepDungeonBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardInnerBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Border.chapterTab">
            <Setter Property="Background" Value="{StaticResource ElevatedSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Padding" Value="13,6" />
            <Setter Property="BoxShadow" Value="0 4 12 0 #55000000" />
        </Style>
        <Style Selector="Border.chapterTab.gold">
            <Setter Property="BorderBrush" Value="{StaticResource AncientGoldBorderFaintBrush}" />
        </Style>
        <Style Selector="Border.chapterTab.arcane">
            <Setter Property="BorderBrush" Value="#668A5CF5" />
        </Style>
        <Style Selector="Border.chapterTab.cyan">
            <Setter Property="BorderBrush" Value="#662CB67D" />
        </Style>

        <!-- Navigation tabs -->
        <Style Selector="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="TabItem.nav">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="{StaticResource ElevatedSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="2"
                            Padding="14,7"
                            BoxShadow="0 4 12 0 #44000000">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Path Data="M4,0 L8,4 L4,8 L0,4 Z"
                                  Width="8" Height="8" Stretch="Fill"
                                  Fill="{TemplateBinding Foreground}"
                                  Opacity="0.85"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="{TemplateBinding Header}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontSize="{TemplateBinding FontSize}"
                                       LetterSpacing="1.4"
                                       Foreground="{TemplateBinding Foreground}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="TabItem.nav:pointerover">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="TabItem.nav:pointerover /template/ Border#Root">
            <Setter Property="BorderBrush" Value="{StaticResource AncientGoldBorderFaintBrush}" />
        </Style>
        <Style Selector="TabItem.nav:selected">
            <Setter Property="Foreground" Value="{StaticResource AncientGoldBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AncientGoldBorderFaintBrush}" />
            <Setter Property="Background" Value="{StaticResource ObsidianBlackBrush}" />
        </Style>

        <Style Selector="Border.statusFrame">
            <Setter Property="Background" Value="{StaticResource ObsidianBlackBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="3" />
        </Style>
        <Style Selector="Border.statusInner">
            <Setter Property="Background" Value="{StaticResource DeepDungeonBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardInnerBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Padding" Value="12,8" />
        </Style>
        <Style Selector="Border.chip">
            <Setter Property="Background" Value="{StaticResource ElevatedSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Padding" Value="8,3" />
        </Style>

        <!-- Inset fields -->
        <Style Selector="TextBox">
            <Setter Property="Background" Value="{StaticResource ObsidianDeepBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource AncientGoldBrush}" />
            <Setter Property="SelectionBrush" Value="{StaticResource AncientGoldTintBrush}" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="TextBox:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource TextSecondaryBrush}" />
        </Style>
        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="{StaticResource AncientGoldBrush}" />
        </Style>

        <Style Selector="NumericUpDown">
            <Setter Property="Background" Value="{StaticResource ObsidianDeepBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="NumericUpDown:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource TextSecondaryBrush}" />
        </Style>
        <Style Selector="NumericUpDown:focus">
            <Setter Property="BorderBrush" Value="{StaticResource AncientGoldBrush}" />
        </Style>

        <!-- Buttons -->
        <Style Selector="Button">
            <Setter Property="Background" Value="{StaticResource ElevatedSurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2D3240" />
            <Setter Property="BorderBrush" Value="#4C5364" />
        </Style>
        <Style Selector="Button:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#1F232D" />
        </Style>

        <Style Selector="Button.outline">
            <Setter Property="Background" Value="{StaticResource ObsidianBlackBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AncientGoldBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AncientGoldBorderFaintBrush}" />
        </Style>
        <Style Selector="Button.outline:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource ElevatedSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AncientGoldBrush}" />
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{StaticResource GoldButtonBrush}" />
            <Setter Property="Foreground" Value="{StaticResource ObsidianBlackBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AncientGoldLightBrush}" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="LetterSpacing" Value="1.2" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AncientGoldLightBrush}" />
            <Setter Property="BorderBrush" Value="#F7D48A" />
        </Style>
        <Style Selector="Button.primary:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AncientGoldDarkBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AncientGoldDarkBrush}" />
        </Style>

        <!-- Custom window caption buttons (system title bar is disabled) -->
        <Style Selector="Button.window">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.window:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource ElevatedSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AncientGoldBorderFaintBrush}" />
        </Style>
        <Style Selector="Button.window:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource DeepDungeonBrush}" />
        </Style>
        <Style Selector="Button.window.close:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#3A1717" />
            <Setter Property="BorderBrush" Value="#8C2F2F" />
        </Style>

        <Style Selector="Button.tab">
            <Setter Property="MinWidth" Value="38" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Background" Value="{StaticResource DeepDungeonBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        </Style>
        <Style Selector="Button.tab:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource ElevatedSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AncientGoldBrush}" />
        </Style>
        <Style Selector="Button.tab.selected">
            <Setter Property="Background" Value="{StaticResource GoldButtonBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AncientGoldLightBrush}" />
            <Setter Property="Foreground" Value="{StaticResource ObsidianBlackBrush}" />
        </Style>
        <Style Selector="Button.tab.selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AncientGoldLightBrush}" />
            <Setter Property="BorderBrush" Value="#F7D48A" />
        </Style>

        <!-- DSO-style diamond checkbox -->
        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid ColumnDefinitions="Auto,*" Background="Transparent">
                        <Grid Width="18" Height="18" VerticalAlignment="Center">
                            <Border x:Name="CheckBoxBox"
                                    Width="14" Height="14"
                                    Background="{StaticResource ObsidianDeepBrush}"
                                    BorderBrush="{StaticResource TextDisabledBrush}"
                                    BorderThickness="1"
                                    CornerRadius="1">
                                <Border.RenderTransform>
                                    <RotateTransform Angle="45" />
                                </Border.RenderTransform>
                            </Border>
                            <Path x:Name="CheckMark"
                                  Data="M 2,9 L 7,14 L 16,3"
                                  Width="18" Height="18"
                                  Stretch="None"
                                  Stroke="{StaticResource AncientGoldBrush}"
                                  StrokeThickness="1.8"
                                  IsVisible="False"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Grid>
                        <ContentPresenter Grid.Column="1"
                                          Margin="9,0,0,0"
                                          VerticalAlignment="Center"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="CheckBox:pointerover">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="CheckBox:pointerover /template/ Border#CheckBoxBox">
            <Setter Property="BorderBrush" Value="{StaticResource AncientGoldBrush}" />
        </Style>
        <Style Selector="CheckBox:checked">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="CheckBox:checked /template/ Border#CheckBoxBox">
            <Setter Property="Background" Value="{StaticResource AncientGoldTintBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AncientGoldBrush}" />
        </Style>
        <Style Selector="CheckBox:checked /template/ Path#CheckMark">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="CheckBox:disabled">
            <Setter Property="Opacity" Value="0.5" />
        </Style>

        <!-- Качества неопознанных предметов: цвета как в DSO, не сливаются с состоянием. -->
        <Style Selector="CheckBox.rarity-common, CheckBox.rarity-common:checked, CheckBox.rarity-common:pointerover">
            <Setter Property="Foreground" Value="{StaticResource RarityCommonBrush}" />
        </Style>
        <Style Selector="CheckBox.rarity-improved, CheckBox.rarity-improved:checked, CheckBox.rarity-improved:pointerover">
            <Setter Property="Foreground" Value="{StaticResource RarityImprovedBrush}" />
        </Style>
        <Style Selector="CheckBox.rarity-magic, CheckBox.rarity-magic:checked, CheckBox.rarity-magic:pointerover">
            <Setter Property="Foreground" Value="{StaticResource RarityMagicBrush}" />
        </Style>
        <Style Selector="CheckBox.rarity-extraordinary, CheckBox.rarity-extraordinary:checked, CheckBox.rarity-extraordinary:pointerover">
            <Setter Property="Foreground" Value="{StaticResource RarityExtraordinaryBrush}" />
        </Style>
        <Style Selector="CheckBox.rarity-legendary, CheckBox.rarity-legendary:checked, CheckBox.rarity-legendary:pointerover">
            <Setter Property="Foreground" Value="{StaticResource RarityLegendaryBrush}" />
        </Style>
        <Style Selector="CheckBox.rarity-unique, CheckBox.rarity-unique:checked, CheckBox.rarity-unique:pointerover">
            <Setter Property="Foreground" Value="{StaticResource RarityUniqueBrush}" />
        </Style>
        <Style Selector="CheckBox.rarity-mythic, CheckBox.rarity-mythic:checked, CheckBox.rarity-mythic:pointerover">
            <Setter Property="Foreground" Value="{StaticResource RarityMythicBrush}" />
        </Style>
    </Window.Styles>

    <Grid>
        <!-- Dragon-scale relief over the stone backdrop -->
        <Image Source="avares://DsoHelper/Assets/Textures/dragon-scales.png"
               Stretch="UniformToFill"
               Opacity="0.28"
               IsHitTestVisible="False" />

        <Border Height="190"
                VerticalAlignment="Top"
                Background="{StaticResource HeaderGlowBrush}"
                IsHitTestVisible="False" />

        <!-- Engraved frame corners -->
        <Path Data="M0,26 L0,0 L26,0"
              Stroke="{StaticResource AncientGoldBrush}"
              StrokeThickness="1.2"
              Opacity="0.5"
              HorizontalAlignment="Left"
              VerticalAlignment="Top"
              Margin="12"
              IsHitTestVisible="False" />
        <Path Data="M0,0 L26,0 L26,26"
              Stroke="{StaticResource AncientGoldBrush}"
              StrokeThickness="1.2"
              Opacity="0.5"
              HorizontalAlignment="Right"
              VerticalAlignment="Top"
              Margin="12"
              IsHitTestVisible="False" />
        <Path Data="M0,0 L0,26 L26,26"
              Stroke="{StaticResource AncientGoldBrush}"
              StrokeThickness="1.2"
              Opacity="0.5"
              HorizontalAlignment="Left"
              VerticalAlignment="Bottom"
              Margin="12"
              IsHitTestVisible="False" />
        <Path Data="M26,0 L26,26 L0,26"
              Stroke="{StaticResource AncientGoldBrush}"
              StrokeThickness="1.2"
              Opacity="0.5"
              HorizontalAlignment="Right"
              VerticalAlignment="Bottom"
              Margin="12"
              IsHitTestVisible="False" />

        <Grid x:Name="MainContentGrid" RowDefinitions="Auto,*,Auto" Margin="30,25,30,22" RowSpacing="16">
            <!-- Header -->
            <StackPanel Grid.Row="0" Spacing="17">
                <!-- Уведомление о доступном обновлении (сверху, появляется после проверки на старте) -->
                <Border x:Name="UpdateBanner"
                        Classes="cardFrame"
                        IsVisible="False"
                        Margin="0,0,0,2">
                    <Border Classes="cardInner">
                        <StackPanel Margin="14,12,14,12" Spacing="9">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock x:Name="UpdateBannerTitle"
                                               Classes="label"
                                               Foreground="{StaticResource AncientGoldBrush}"
                                               Text="Доступно обновление" />
                                    <TextBlock x:Name="UpdateBannerText"
                                               Classes="hint"
                                               TextWrapping="Wrap"
                                               Text="Новая версия готова к загрузке." />
                                </StackPanel>

                                <Button x:Name="UpdateBannerButton"
                                        Grid.Column="1"
                                        Classes="outline"
                                        Content="Обновить"
                                        VerticalAlignment="Center"
                                        Click="OnBannerUpdateClick" />

                                <Button x:Name="UpdateBannerCloseButton"
                                        Grid.Column="2"
                                        Classes="window"
                                        VerticalAlignment="Center"
                                        Click="OnBannerCloseClick"
                                        ToolTip.Tip="Скрыть уведомление">
                                    <Path Data="M1,1 L11,11 M11,1 L1,11"
                                          Stroke="{StaticResource AncientGoldBrush}"
                                          StrokeThickness="1.5"
                                          Width="12" Height="12"
                                          Stretch="None"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                </Button>
                            </Grid>

                            <ProgressBar x:Name="UpdateBannerProgressBar"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="0"
                                         Height="6"
                                         CornerRadius="2"
                                         Background="{StaticResource ObsidianBlackBrush}"
                                         BorderBrush="{StaticResource AncientGoldBorderFaintBrush}"
                                         BorderThickness="1"
                                         Foreground="{StaticResource AncientGoldBrush}"
                                         IsVisible="False" />
                        </StackPanel>
                    </Border>
                </Border>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="17"
                      Background="Transparent"
                      PointerPressed="OnTitleBarPointerPressed">
                    <Border Width="52"
                            Height="52"
                            CornerRadius="26"
                            Background="{StaticResource ObsidianBlackBrush}"
                            BorderBrush="{StaticResource AncientGoldBorderFaintBrush}"
                            BorderThickness="1"
                            BoxShadow="0 0 24 0 #55E0A93B"
                            VerticalAlignment="Center">
                        <Viewbox Width="38" Height="38">
                            <Canvas Width="64" Height="64">
                                <Path Data="M32,2 L59,13 L54,43 C52,52 43,59 32,62 C21,59 12,52 10,43 L5,13 Z"
                                      Fill="{StaticResource ElevatedSurfaceBrush}"
                                      Stroke="{StaticResource AncientGoldBrush}"
                                      StrokeThickness="1.2" />
                                <Path Data="M22,17 L26,11 L27,18 Z M42,17 L38,11 L37,18 Z"
                                      Fill="{StaticResource AncientGoldBrush}"
                                      Opacity="0.72" />
                                <Path Data="M19,31 C24,24 29,21 32,21 C35,21 40,24 45,31 C40,38 35,41 32,41 C29,41 24,38 19,31 Z"
                                      Fill="{StaticResource ObsidianBlackBrush}"
                                      Stroke="{StaticResource AncientGoldBrush}"
                                      StrokeThickness="1.2" />
                                <Path Data="M32,24 C35,28 35,34 32,38 C29,34 29,28 32,24 Z"
                                      Fill="{StaticResource AncientGoldBrush}" />
                            </Canvas>
                        </Viewbox>
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                        <TextBlock Classes="h1" Text="DSO HELPER" FontSize="24" />
                        <TextBlock Classes="subtitle"
                                   Text="Fast Mount" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                            <Button x:Name="SettingsButton"
                                    Classes="window"
                                    Click="OnSettingsClick"
                                    ToolTip.Tip="Настройки и обновления">
                                <Path Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.07,0.94l-2.03,1.58c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z"
                                      Fill="{StaticResource AncientGoldBrush}"
                                      Width="12" Height="12"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Button>
                            <Button Classes="window"
                                    Click="OnMinimizeClick"
                                    ToolTip.Tip="Свернуть в трей">
                                <Path Data="M0,6 L12,6"
                                      Stroke="{StaticResource AncientGoldBrush}"
                                      StrokeThickness="1.5"
                                      Width="12" Height="12"
                                      Stretch="None"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Button>
                            <Button Classes="window close"
                                    Click="OnCloseClick"
                                    ToolTip.Tip="Закрыть">
                                <Path Data="M1,1 L11,11 M11,1 L1,11"
                                      Stroke="{StaticResource AncientGoldBrush}"
                                      StrokeThickness="1.5"
                                      Width="12" Height="12"
                                      Stretch="None"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Button>
                        </StackPanel>
                        <CheckBox x:Name="AlwaysOnTopCheck"
                                  Content="Поверх окон"
                                  HorizontalAlignment="Right"
                                  Margin="0,4,2,4" />
                    </StackPanel>
                </Grid>

                <!-- Ornate divider -->
                <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="11">
                    <Border Height="1"
                            Background="{StaticResource GoldRuleLeftBrush}"
                            VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Path Data="M0,4 L7,0 L14,4 L7,8 Z"
                              Width="14" Height="8" Stretch="Fill"
                              Fill="{StaticResource AncientGoldBrush}"
                              Opacity="0.45" />
                        <Path Data="M6,0 L12,6 L6,12 L0,6 Z"
                              Width="12" Height="12" Stretch="Fill"
                              Fill="{StaticResource AncientGoldBrush}" />
                        <Path Data="M0,4 L7,0 L14,4 L7,8 Z"
                              Width="14" Height="8" Stretch="Fill"
                              Fill="{StaticResource AncientGoldBrush}"
                              Opacity="0.45" />
                    </StackPanel>
                    <Border Grid.Column="2"
                            Height="1"
                            Background="{StaticResource GoldRuleRightBrush}"
                            VerticalAlignment="Center" />
                </Grid>
            </StackPanel>

            <!-- Chapters: three tabs -->
            <TabControl x:Name="MainTabControl" Grid.Row="1" Background="Transparent">
                <TabItem Classes="nav" Header="ИНВЕНТАРЬ">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Hidden">
                        <StackPanel Spacing="19" Margin="0,12,0,0">
                            <!-- I. Grid calibration (slot #1 / #28) -->
                            <Grid>
                                <Border Classes="cardFrame" Margin="0,16,0,0">
                                    <Border Classes="cardInner">
                                        <Grid>
                                            <Border Width="13" Height="13" BorderBrush="{StaticResource AncientGoldBrush}" BorderThickness="1,1,0,0" Opacity="0.4" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                            <Border Width="13" Height="13" BorderBrush="{StaticResource AncientGoldBrush}" BorderThickness="0,1,1,0" Opacity="0.4" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                            <Border Width="13" Height="13" BorderBrush="{StaticResource AncientGoldBrush}" BorderThickness="1,0,0,1" Opacity="0.4" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                                            <Border Width="13" Height="13" BorderBrush="{StaticResource AncientGoldBrush}" BorderThickness="0,0,1,1" Opacity="0.4" HorizontalAlignment="Right" VerticalAlignment="Bottom" />

                                            <StackPanel Margin="22,26,22,18" Spacing="13">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                                    <StackPanel Spacing="4" VerticalAlignment="Center">
                                                        <TextBlock x:Name="InvStatusText"
                                                                   Classes="label"
                                                                   Text="Сетка не откалибрована" />
                                                        <TextBlock x:Name="InvSummaryText"
                                                                   Classes="hint"
                                                                   TextWrapping="Wrap"
                                                                   Text="Шаг 1: укажите центр ячейки №1 (левая верхняя) и ячейки №28 (правая нижняя). Шаг 2: нажмите «Проверить инвентарь»." />
                                                    </StackPanel>
                                                </Grid>

                                                <Border Height="1" Background="{StaticResource CardInnerBorderBrush}" />

                                                <TextBlock Classes="hint"
                                                           TextWrapping="Wrap"
                                                           Foreground="{StaticResource AncientGoldLightBrush}"
                                                           Text="⚠ Важно: калибруйте сетку и запускайте проверку только в полноэкранном режиме игры (без рамки). Сетка привязана к размеру окна. Если вы изменили разрешение или размер окна, откалибруйте заново, иначе результаты будут неверными." />

                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Button x:Name="PickInvSlot1Button"
                                                            Classes="outline"
                                                            Content="Слот #1"
                                                            Click="OnPickInvSlot1Click" />
                                                    <Button x:Name="PickInvSlot28Button"
                                                            Classes="outline"
                                                            Content="Слот #28"
                                                            Click="OnPickInvSlot28Click" />
                                                </StackPanel>

                                                <TextBlock Classes="hint"
                                                           TextWrapping="Wrap"
                                                           Text="Как калибровать: 1) откройте инвентарь в игре; 2) нажмите «Слот #1» и кликните по центру левой верхней ячейки; 3) нажмите «Слот #28» и кликните по центру правой нижней ячейки. Положение остальных ячеек (сетка 7×4) программа рассчитает сама." />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Border>

                                <Border Classes="chapterTab gold"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Margin="18,0,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Path Data="M4,0 L8,4 L4,8 L0,4 Z" Width="8" Height="8" Stretch="Fill" Fill="{StaticResource AncientGoldBrush}" VerticalAlignment="Center" />
                                        <TextBlock Classes="chapterTitle" Text="I" Foreground="{StaticResource AncientGoldBrush}" />
                                        <TextBlock Classes="chapterTitle" Text="КАЛИБРОВКА СЕТКИ" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- II. Tab calibration (shared by Fast Mount and Auto-sell) -->
                            <Grid>
                                <Border Classes="cardFrame" Margin="0,16,0,0">
                                    <Border Classes="cardInner">
                                        <Grid>
                                            <Border Width="13" Height="13" BorderBrush="{StaticResource AncientGoldBrush}" BorderThickness="1,1,0,0" Opacity="0.4" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                            <Border Width="13" Height="13" BorderBrush="{StaticResource AncientGoldBrush}" BorderThickness="0,1,1,0" Opacity="0.4" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                            <Border Width="13" Height="13" BorderBrush="{StaticResource AncientGoldBrush}" BorderThickness="1,0,0,1" Opacity="0.4" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                                            <Border Width="13" Height="13" BorderBrush="{StaticResource AncientGoldBrush}" BorderThickness="0,0,1,1" Opacity="0.4" HorizontalAlignment="Right" VerticalAlignment="Bottom" />

                                            <StackPanel Margin="22,26,22,18" Spacing="13">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                                    <TextBlock x:Name="TabStatusText"
                                                               Classes="hint"
                                                               TextWrapping="Wrap"
                                                               Text="Позиция вкладок не откалибрована."
                                                               VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                        <Button x:Name="PickTabButton"
                                                                Classes="outline"
                                                                Content="Указать вкладку 1"
                                                                Click="OnPickTabClick" />
                                                        <Button x:Name="PickTabStepButton"
                                                                Classes="outline"
                                                                Content="Указать вкладку 2"
                                                                Click="OnPickTabStepClick" />
                                                    </StackPanel>
                                                </Grid>

                                                <TextBlock Classes="hint"
                                                           TextWrapping="Wrap"
                                                           Text="Нужно для Fast Mount и автопродажи, чтобы программа умела переключать вкладки инвентаря. 1) Нажмите «Указать вкладку 1» и кликните по заголовку первой вкладки. 2) Нажмите «Указать вкладку 2» и кликните по заголовку второй. Расстояние между ними программа применит к остальным вкладкам. Какую вкладку использовать, выбирается на странице «FAST MOUNT»." />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Border>

                                <Border Classes="chapterTab gold"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Margin="18,0,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Path Data="M4,0 L8,4 L4,8 L0,4 Z" Width="8" Height="8" Stretch="Fill" Fill="{StaticResource AncientGoldBrush}" VerticalAlignment="Center" />
                                        <TextBlock Classes="chapterTitle" Text="II" Foreground="{StaticResource AncientGoldBrush}" />
                                        <TextBlock Classes="chapterTitle" Text="КАЛИБРОВКА ВКЛАДОК" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- III. Inventory check -->
                            <Grid>
                                <Border Classes="cardFrame" Margin="0,16,0,0">
                                    <Border Classes="cardInner">
                                        <Grid>
                                            <Border Width="13" Height="13" BorderBrush="{StaticResource AncientGoldBrush}" BorderThickness="1,1,0,0" Opacity="0.4" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                            <Border Width="13" Height="13" BorderBrush="{StaticResource AncientGoldBrush}" BorderThickness="0,1,1,0" Opacity="0.4" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                            <Border Width="13" Height="13" BorderBrush="{StaticResource AncientGoldBrush}" BorderThickness="1,0,0,1" Opacity="0.4" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                                            <Border Width="13" Height="13" BorderBrush="{StaticResource AncientGoldBrush}" BorderThickness="0,0,1,1" Opacity="0.4" HorizontalAlignment="Right" VerticalAlignment="Bottom" />

                                            <StackPanel Margin="22,26,22,18" Spacing="13">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Button x:Name="CheckInventoryButton"
                                                            Classes="outline"
                                                            Content="Проверить инвентарь"
                                                            Click="OnCheckInventoryClick"
                                                            ToolTip.Tip="Делает снимок окна игры и определяет, что лежит в каждой из 28 ячеек: пусто, обычный, улучшенный, магический, экстраординарный, легендарный, уникальный, мифический или неопознанный («?»). Запускайте в полноэкранном режиме игры." />
                                                    <Button x:Name="HoverInventoryButton"
                                                            Classes="outline"
                                                            Content="Наводить на предметы"
                                                            Click="OnHoverInventoryClick"
                                                            ToolTip.Tip="Курсор по очереди наводится на каждую занятую ячейку и ненадолго задерживается, чтобы успела появиться подсказка предмета. В конце курсор возвращается на прежнее место. Запускайте в полноэкранном режиме игры." />
                                                </StackPanel>
                                                <TextBlock Classes="hint"
                                                           TextWrapping="Wrap"
                                                           Text="Перед запуском откройте инвентарь в игре. Итог проверки (сколько ячеек какого качества) появится в статусной строке внизу окна." />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Border>

                                <Border Classes="chapterTab gold"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Margin="18,0,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Path Data="M4,0 L8,4 L4,8 L0,4 Z" Width="8" Height="8" Stretch="Fill" Fill="{StaticResource AncientGoldBrush}" VerticalAlignment="Center" />
                                        <TextBlock Classes="chapterTitle" Text="III" Foreground="{StaticResource AncientGoldBrush}" />
                                        <TextBlock Classes="chapterTitle" Text="ПРОВЕРКА ИНВЕНТАРЯ 7×4" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Classes="nav" Header="FAST MOUNT">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Hidden">
                        <StackPanel Spacing="19" Margin="0,12,0,0">
                            <!-- I. Cape slot -->
                            <Grid>
                                <Border Classes="cardFrame" Margin="0,16,0,0">
                                    <Border Classes="cardInner">
                                        <Grid>
                                            <Border Width="13" Height="13" BorderBrush="{StaticResource AncientGoldBrush}" BorderThickness="1,1,0,0" Opacity="0.4" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                            <Border Width="13" Height="13" BorderBrush="{StaticResource AncientGoldBrush}" BorderThickness="0,1,1,0" Opacity="0.4" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                            <Border Width="13" Height="13" BorderBrush="{StaticResource AncientGoldBrush}" BorderThickness="1,0,0,1" Opacity="0.4" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                                            <Border Width="13" Height="13" BorderBrush="{StaticResource AncientGoldBrush}" BorderThickness="0,0,1,1" Opacity="0.4" HorizontalAlignment="Right" VerticalAlignment="Bottom" />

                                            <StackPanel Margin="22,26,22,18" Spacing="13">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                                    <StackPanel Spacing="4" VerticalAlignment="Center">
                                                        <TextBlock x:Name="SlotStatusText"
                                                                   Classes="label"
                                                                   Text="Слот не выбран" />
                                                        <TextBlock x:Name="SlotCoordsText"
                                                                   Classes="hint"
                                                                   Text="Нажмите «Выбрать слот» и кликните по ячейке, где лежит плащ: квадрат следует за курсором." />
                                                    </StackPanel>
                                                    <Button x:Name="PickSlotButton"
                                                            Grid.Column="1"
                                                            Classes="outline"
                                                            Content="Выбрать слот"
                                                            VerticalAlignment="Center"
                                                            Click="OnPickSlotClick" />
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Border>

                                <Border Classes="chapterTab arcane"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Margin="18,0,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Path Data="M4,0 L8,4 L4,8 L0,4 Z" Width="8" Height="8" Stretch="Fill" Fill="{StaticResource MysticArcaneBrush}" VerticalAlignment="Center" />
                                        <TextBlock Classes="chapterTitle" Text="I" Foreground="{StaticResource MysticArcaneBrush}" />
                                        <TextBlock Classes="chapterTitle" Text="СЛОТ ПЛАЩА" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- II. Inventory tab to switch to -->
                            <Grid>
                                <Border Classes="cardFrame" Margin="0,16,0,0">
                                    <Border Classes="cardInner">
                                        <Grid>
                                            <Border Width="13" Height="13" BorderBrush="{StaticResource AncientGoldBrush}" BorderThickness="1,1,0,0" Opacity="0.4" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                            <Border Width="13" Height="13" BorderBrush="{StaticResource AncientGoldBrush}" BorderThickness="0,1,1,0" Opacity="0.4" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                            <Border Width="13" Height="13" BorderBrush="{StaticResource AncientGoldBrush}" BorderThickness="1,0,0,1" Opacity="0.4" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                                            <Border Width="13" Height="13" BorderBrush="{StaticResource AncientGoldBrush}" BorderThickness="0,0,1,1" Opacity="0.4" HorizontalAlignment="Right" VerticalAlignment="Bottom" />

                                            <StackPanel Margin="22,26,22,18" Spacing="13">
                                                <CheckBox x:Name="SwitchTabCheck"
                                                          Content="Переключать вкладку"
                                                          VerticalAlignment="Center" />

                                                <StackPanel x:Name="TabButtonsPanel"
                                                            Orientation="Horizontal"
                                                            Spacing="6">
                                                    <Button Classes="tab" Tag="1" Content="1" Click="OnTabSelectClick" />
                                                    <Button Classes="tab" Tag="2" Content="2" Click="OnTabSelectClick" />
                                                    <Button Classes="tab" Tag="3" Content="3" Click="OnTabSelectClick" />
                                                    <Button Classes="tab" Tag="4" Content="4" Click="OnTabSelectClick" />
                                                    <Button Classes="tab" Tag="5" Content="5" Click="OnTabSelectClick" />
                                                    <Button Classes="tab" Tag="6" Content="6" Click="OnTabSelectClick" />
                                                    <Button Classes="tab" Tag="7" Content="7" Click="OnTabSelectClick" />
                                                    <Button Classes="tab" Tag="8" Content="8" Click="OnTabSelectClick" />
                                                    <Button Classes="tab" Tag="prem" Content="prem" Click="OnTabSelectClick" />
                                                </StackPanel>

                                                <TextBlock x:Name="TabSelectStatusText"
                                                           Classes="hint"
                                                           TextWrapping="Wrap"
                                                           Text="Выбранная вкладка — 1."
                                                           VerticalAlignment="Center" />
                                                <TextBlock Classes="hint"
                                                           TextWrapping="Wrap"
                                                           Text="Позиции вкладок задаются на странице «ИНВЕНТАРЬ», в блоке «II. Калибровка вкладок»." />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Border>

                                <Border Classes="chapterTab arcane"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Margin="18,0,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Path Data="M4,0 L8,4 L4,8 L0,4 Z" Width="8" Height="8" Stretch="Fill" Fill="{StaticResource MysticArcaneBrush}" VerticalAlignment="Center" />
                                        <TextBlock Classes="chapterTitle" Text="II" Foreground="{StaticResource MysticArcaneBrush}" />
                                        <TextBlock Classes="chapterTitle" Text="ВКЛАДКА ИНВЕНТАРЯ" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- III. Keys and delays -->
                            <Grid>
                                <Border Classes="cardFrame" Margin="0,16,0,0">
                                    <Border Classes="cardInner">
                                        <Grid>
                                            <Border Width="13" Height="13" BorderBrush="{StaticResource AncientGoldBrush}" BorderThickness="1,1,0,0" Opacity="0.4" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                            <Border Width="13" Height="13" BorderBrush="{StaticResource AncientGoldBrush}" BorderThickness="0,1,1,0" Opacity="0.4" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                            <Border Width="13" Height="13" BorderBrush="{StaticResource AncientGoldBrush}" BorderThickness="1,0,0,1" Opacity="0.4" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                                            <Border Width="13" Height="13" BorderBrush="{StaticResource AncientGoldBrush}" BorderThickness="0,0,1,1" Opacity="0.4" HorizontalAlignment="Right" VerticalAlignment="Bottom" />

                                            <StackPanel Margin="22,26,22,18" Spacing="13">
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                    <TextBlock Classes="subheading" Text="КЛАВИШИ" />
                                                    <Border Grid.Column="1" Height="1" Background="{StaticResource BorderBrush}" Opacity="0.7" VerticalAlignment="Center" />
                                                </Grid>

                                                <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="14">
                                                    <StackPanel Spacing="5">
                                                        <TextBlock Classes="axis" Text="Инвентарь" />
                                                        <TextBox x:Name="InventoryKeyBox"
                                                                 Width="126" Height="38"
                                                                 IsReadOnly="True"
                                                                 AutomationProperties.AutomationId="InventoryKeyBox"
                                                                 PlaceholderText="Нажмите клавишу" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Spacing="5">
                                                        <TextBlock Classes="axis" Text="Кнопка маунта" />
                                                        <TextBox x:Name="MountKeyBox"
                                                                 Width="126" Height="38"
                                                                 IsReadOnly="True"
                                                                 AutomationProperties.AutomationId="MountKeyBox"
                                                                 PlaceholderText="Нажмите клавишу" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Spacing="5">
                                                        <TextBlock Classes="axis" Text="Хоткей" />
                                                        <TextBox x:Name="HotkeyBox"
                                                                 Width="150" Height="38"
                                                                 IsReadOnly="True"
                                                                 AutomationProperties.AutomationId="HotkeyBox"
                                                                 PlaceholderText="Нажмите клавишу" />
                                                        <TextBlock x:Name="HotkeyStatusText"
                                                                   Classes="hint" />
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Classes="hint"
                                                           Text="«Инвентарь» и «Кнопка маунта» — клавиши, назначенные в игре. «Хоткей» — клавиша, по которой запускается Fast Mount. Кликните по полю и нажмите нужную клавишу: название подставится само (например Space, F1, ←). Esc отменяет ввод." />
                                                <TextBlock Classes="hint"
                                                           Text="Хоткей работает только пока активно окно Drakensang." />

                                                <Border Height="1" Background="{StaticResource CardInnerBorderBrush}" />

                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                    <TextBlock Classes="subheading" Text="ЗАДЕРЖКА, МС" />
                                                    <Border Grid.Column="1" Height="1" Background="{StaticResource BorderBrush}" Opacity="0.7" VerticalAlignment="Center" />
                                                </Grid>

                                                <StackPanel Spacing="5">
                                                    <StackPanel.Styles>
                                                        <Style Selector="TextBox.compact">
                                                            <Setter Property="Height" Value="26" />
                                                            <Setter Property="Width" Value="68" />
                                                            <Setter Property="MinHeight" Value="0" />
                                                            <Setter Property="Padding" Value="6,2,8,2" />
                                                            <Setter Property="FontSize" Value="12" />
                                                            <Setter Property="TextAlignment" Value="Right" />
                                                            <Setter Property="CornerRadius" Value="2" />
                                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                                        </Style>
                                                    </StackPanel.Styles>
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Classes="axis" Text="Пауза между действиями" />
                                                        <TextBox x:Name="DelayValueBox"
                                                                 Grid.Column="1"
                                                                 Classes="compact"
                                                                 Text="300"
                                                                 AutomationProperties.AutomationId="DelayValueBox" />
                                                    </Grid>
                                                    <Slider x:Name="DelaySlider"
                                                            Minimum="0"
                                                            Maximum="1000"
                                                            Value="300"
                                                            SmallChange="15"
                                                            LargeChange="60"
                                                            Height="38"
                                                            VerticalAlignment="Center" />
                                                    <TextBlock Classes="hint"
                                                               Text="Ползунок двигается с шагом 15 мс. Точное значение (0–1000) можно ввести вручную. Если игра не успевает реагировать, увеличьте паузу." />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Border>

                                <Border Classes="chapterTab cyan"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Margin="18,0,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Path Data="M4,0 L8,4 L4,8 L0,4 Z" Width="8" Height="8" Stretch="Fill" Fill="{StaticResource EssenceCyanBrush}" VerticalAlignment="Center" />
                                        <TextBlock Classes="chapterTitle" Text="III" Foreground="{StaticResource EssenceCyanBrush}" />
                                        <TextBlock Classes="chapterTitle" Text="КЛАВИШИ И ЗАДЕРЖКИ" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Classes="nav" Header="АВТОПРОДАЖА">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Hidden">
                        <StackPanel Spacing="19" Margin="0,12,0,0">
                            <!-- I. Launch and hotkey -->
                            <Grid>
                                <Border Classes="cardFrame" Margin="0,16,0,0">
                                    <Border Classes="cardInner">
                                        <Grid>
                                            <Border Width="13" Height="13" BorderBrush="{StaticResource AncientGoldBrush}" BorderThickness="1,1,0,0" Opacity="0.4" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                            <Border Width="13" Height="13" BorderBrush="{StaticResource AncientGoldBrush}" BorderThickness="0,1,1,0" Opacity="0.4" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                            <Border Width="13" Height="13" BorderBrush="{StaticResource AncientGoldBrush}" BorderThickness="1,0,0,1" Opacity="0.4" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                                            <Border Width="13" Height="13" BorderBrush="{StaticResource AncientGoldBrush}" BorderThickness="0,0,1,1" Opacity="0.4" HorizontalAlignment="Right" VerticalAlignment="Bottom" />

                                            <StackPanel Margin="22,26,22,18" Spacing="13">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                                    <StackPanel Spacing="4" VerticalAlignment="Center">
                                                        <TextBlock x:Name="AutoSellStatusText"
                                                                   Classes="label"
                                                                   Text="Автопродажа ещё не запускалась" />
                                                        <TextBlock x:Name="AutoSellSummaryText"
                                                                   Classes="hint"
                                                                   TextWrapping="Wrap"
                                                                   Text="Проходит по сетке 7×4 и продаёт правой кнопкой мыши только неопознанные предметы («?») отмеченного ниже качества. Опознанные предметы не затрагиваются." />
                                                    </StackPanel>
                                                </Grid>

                                                <Border Height="1" Background="{StaticResource CardInnerBorderBrush}" />

                                                <TextBlock Classes="hint"
                                                           TextWrapping="Wrap"
                                                           Foreground="{StaticResource AncientGoldLightBrush}"
                                                           Text="⚠ Сначала откройте окно торговца! Правый клик продаёт предмет только в открытом магазине, иначе игра наденет или применит предмет. Продажа идёт сразу, без подтверждения, поэтому проверьте отмеченные качества перед запуском." />

                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                    <TextBlock Classes="subheading" Text="ЗАПУСК" />
                                                    <Border Grid.Column="1" Height="1" Background="{StaticResource BorderBrush}" Opacity="0.7" VerticalAlignment="Center" />
                                                </Grid>

                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Button x:Name="AutoSellButton"
                                                            Classes="outline"
                                                            Content="Запустить автопродажу"
                                                            Click="OnAutoSellClick"
                                                            ToolTip.Tip="Программа сканирует сетку и кликает правой кнопкой по каждой ячейке с неопознанным предметом отмеченного качества. В конце курсор возвращается на прежнее место. Нужен открытый магазин торговца." />
                                                </StackPanel>
                                                <TextBlock Classes="hint"
                                                           TextWrapping="Wrap"
                                                           Text="Откройте инвентарь и магазин торговца, затем нажмите кнопку или хоткей. Пока идёт продажа, калибровка и другие действия недоступны." />

                                                <Border Height="1" Background="{StaticResource CardInnerBorderBrush}" />

                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                    <TextBlock Classes="subheading" Text="ХОТКЕЙ" />
                                                    <Border Grid.Column="1" Height="1" Background="{StaticResource BorderBrush}" Opacity="0.7" VerticalAlignment="Center" />
                                                </Grid>

                                                <StackPanel Spacing="5">
                                                    <TextBox x:Name="SellHotkeyBox"
                                                             Width="150" Height="38"
                                                             IsReadOnly="True"
                                                             PlaceholderText="Нажмите клавишу" />
                                                    <TextBlock x:Name="SellHotkeyStatusText"
                                                               Classes="hint" />
                                                    <TextBlock Classes="hint"
                                                               Text="Кликните по полю и нажмите клавишу (по умолчанию F9). Esc отменяет ввод. Хоткей работает только пока активно окно Drakensang." />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Border>

                                <Border Classes="chapterTab gold"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Margin="18,0,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Path Data="M4,0 L8,4 L4,8 L0,4 Z" Width="8" Height="8" Stretch="Fill" Fill="{StaticResource AncientGoldBrush}" VerticalAlignment="Center" />
                                        <TextBlock Classes="chapterTitle" Text="I" Foreground="{StaticResource AncientGoldBrush}" />
                                        <TextBlock Classes="chapterTitle" Text="ЗАПУСК И ХОТКЕЙ" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- II. Quality filter -->
                            <Grid>
                                <Border Classes="cardFrame" Margin="0,16,0,0">
                                    <Border Classes="cardInner">
                                        <Grid>
                                            <Border Width="13" Height="13" BorderBrush="{StaticResource AncientGoldBrush}" BorderThickness="1,1,0,0" Opacity="0.4" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                            <Border Width="13" Height="13" BorderBrush="{StaticResource AncientGoldBrush}" BorderThickness="0,1,1,0" Opacity="0.4" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                            <Border Width="13" Height="13" BorderBrush="{StaticResource AncientGoldBrush}" BorderThickness="1,0,0,1" Opacity="0.4" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                                            <Border Width="13" Height="13" BorderBrush="{StaticResource AncientGoldBrush}" BorderThickness="0,0,1,1" Opacity="0.4" HorizontalAlignment="Right" VerticalAlignment="Bottom" />

                                            <StackPanel Margin="22,26,22,18" Spacing="13">
                                                <WrapPanel HorizontalAlignment="Left">
                                                    <CheckBox x:Name="SellImprovedCheck"
                                                              Classes="rarity-improved"
                                                              Content="Улучшенный"
                                                              Margin="0,2,18,2" />
                                                    <CheckBox x:Name="SellMagicCheck"
                                                              Classes="rarity-magic"
                                                              Content="Магический"
                                                              Margin="0,2,18,2" />
                                                    <CheckBox x:Name="SellExtraordinaryCheck"
                                                              Classes="rarity-extraordinary"
                                                              Content="Экстраординарный"
                                                              Margin="0,2,18,2" />
                                                    <CheckBox x:Name="SellLegendaryCheck"
                                                              Classes="rarity-legendary"
                                                              Content="Легендарный"
                                                              Margin="0,2,18,2" />
                                                    <CheckBox x:Name="SellUniqueCheck"
                                                              Classes="rarity-unique"
                                                              Content="Уникальный"
                                                              Margin="0,2,18,2" />
                                                    <CheckBox x:Name="SellMythicCheck"
                                                              Classes="rarity-mythic"
                                                              Content="Мифический"
                                                              Margin="0,2,18,2" />
                                                </WrapPanel>

                                                <TextBlock Classes="hint"
                                                           TextWrapping="Wrap"
                                                           Text="Продаются только неопознанные предметы («?») и только отмеченных качеств. Качество определяется по цвету знака вопроса. Опознанные предметы не продаются, даже если их качество отмечено. По умолчанию отмечены низкие качества: Улучшенный, Магический." />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Border>

                                <Border Classes="chapterTab gold"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Margin="18,0,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Path Data="M4,0 L8,4 L4,8 L0,4 Z" Width="8" Height="8" Stretch="Fill" Fill="{StaticResource AncientGoldBrush}" VerticalAlignment="Center" />
                                        <TextBlock Classes="chapterTitle" Text="II" Foreground="{StaticResource AncientGoldBrush}" />
                                        <TextBlock Classes="chapterTitle" Text="КАЧЕСТВО НЕОПОЗНАННЫХ" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- III. Tabs to sweep -->
                            <Grid>
                                <Border Classes="cardFrame" Margin="0,16,0,0">
                                    <Border Classes="cardInner">
                                        <Grid>
                                            <Border Width="13" Height="13" BorderBrush="{StaticResource AncientGoldBrush}" BorderThickness="1,1,0,0" Opacity="0.4" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                            <Border Width="13" Height="13" BorderBrush="{StaticResource AncientGoldBrush}" BorderThickness="0,1,1,0" Opacity="0.4" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                            <Border Width="13" Height="13" BorderBrush="{StaticResource AncientGoldBrush}" BorderThickness="1,0,0,1" Opacity="0.4" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                                            <Border Width="13" Height="13" BorderBrush="{StaticResource AncientGoldBrush}" BorderThickness="0,0,1,1" Opacity="0.4" HorizontalAlignment="Right" VerticalAlignment="Bottom" />

                                            <StackPanel Margin="22,26,22,18" Spacing="13">
                                                <WrapPanel HorizontalAlignment="Left">
                                                    <StackPanel x:Name="SellTabsPanel"
                                                                Orientation="Horizontal"
                                                                Spacing="6">
                                                        <Button Classes="tab" Tag="1" Content="1" Click="OnSellTabToggleClick" />
                                                        <Button Classes="tab" Tag="2" Content="2" Click="OnSellTabToggleClick" />
                                                        <Button Classes="tab" Tag="3" Content="3" Click="OnSellTabToggleClick" />
                                                        <Button Classes="tab" Tag="4" Content="4" Click="OnSellTabToggleClick" />
                                                        <Button Classes="tab" Tag="5" Content="5" Click="OnSellTabToggleClick" />
                                                        <Button Classes="tab" Tag="6" Content="6" Click="OnSellTabToggleClick" />
                                                        <Button Classes="tab" Tag="7" Content="7" Click="OnSellTabToggleClick" />
                                                        <Button Classes="tab" Tag="8" Content="8" Click="OnSellTabToggleClick" />
                                                        <Button Classes="tab" Tag="prem" Content="prem" Click="OnSellTabToggleClick" />
                                                    </StackPanel>
                                                </WrapPanel>

                                                <TextBlock Classes="hint"
                                                           TextWrapping="Wrap"
                                                           Text="Для каждой отмеченной вкладки программа открывает её, просматривает 28 ячеек, продаёт подходящие предметы и переходит к следующей. Неотмеченные вкладки пропускаются. Для всех вкладок, кроме 1-й, нужна калибровка вкладок (страница «ИНВЕНТАРЬ», блок «II. Калибровка вкладок»). Магазин торговца должен быть открыт: он действует на все вкладки." />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Border>

                                <Border Classes="chapterTab gold"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Margin="18,0,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Path Data="M4,0 L8,4 L4,8 L0,4 Z" Width="8" Height="8" Stretch="Fill" Fill="{StaticResource AncientGoldBrush}" VerticalAlignment="Center" />
                                        <TextBlock Classes="chapterTitle" Text="III" Foreground="{StaticResource AncientGoldBrush}" />
                                        <TextBlock Classes="chapterTitle" Text="ВКЛАДКИ ДЛЯ ОБХОДА" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- IV. Delays -->
                            <Grid>
                                <Border Classes="cardFrame" Margin="0,16,0,0">
                                    <Border Classes="cardInner">
                                        <Grid>
                                            <Border Width="13" Height="13" BorderBrush="{StaticResource AncientGoldBrush}" BorderThickness="1,1,0,0" Opacity="0.4" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                            <Border Width="13" Height="13" BorderBrush="{StaticResource AncientGoldBrush}" BorderThickness="0,1,1,0" Opacity="0.4" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                            <Border Width="13" Height="13" BorderBrush="{StaticResource AncientGoldBrush}" BorderThickness="1,0,0,1" Opacity="0.4" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                                            <Border Width="13" Height="13" BorderBrush="{StaticResource AncientGoldBrush}" BorderThickness="0,0,1,1" Opacity="0.4" HorizontalAlignment="Right" VerticalAlignment="Bottom" />

                                            <StackPanel Margin="22,26,22,18" Spacing="13">
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                    <TextBlock Classes="subheading" Text="ЗАДЕРЖКИ, МС" />
                                                    <Border Grid.Column="1" Height="1" Background="{StaticResource BorderBrush}" Opacity="0.7" VerticalAlignment="Center" />
                                                </Grid>

                                                <StackPanel Spacing="5">
                                                    <StackPanel.Styles>
                                                        <Style Selector="TextBox.compact">
                                                            <Setter Property="Height" Value="26" />
                                                            <Setter Property="Width" Value="68" />
                                                            <Setter Property="MinHeight" Value="0" />
                                                            <Setter Property="Padding" Value="6,2,8,2" />
                                                            <Setter Property="FontSize" Value="12" />
                                                            <Setter Property="TextAlignment" Value="Right" />
                                                            <Setter Property="CornerRadius" Value="2" />
                                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                                        </Style>
                                                    </StackPanel.Styles>
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Classes="axis" Text="Пауза после вкладки" />
                                                        <TextBox x:Name="SellSwitchValueBox"
                                                                 Grid.Column="1"
                                                                 Classes="compact"
                                                                 Text="200"
                                                                 AutomationProperties.AutomationId="SellSwitchValueBox" />
                                                    </Grid>
                                                    <Slider x:Name="SellSwitchSlider"
                                                            Minimum="0"
                                                            Maximum="1000"
                                                            Value="200"
                                                            SmallChange="15"
                                                            LargeChange="60"
                                                            Height="38"
                                                            VerticalAlignment="Center" />
                                                    <TextBlock Classes="hint"
                                                               Text="После клика по заголовку вкладки, перед сканом сетки." />
                                                </StackPanel>

                                                <StackPanel Spacing="5">
                                                    <StackPanel.Styles>
                                                        <Style Selector="TextBox.compact">
                                                            <Setter Property="Height" Value="26" />
                                                            <Setter Property="Width" Value="68" />
                                                            <Setter Property="MinHeight" Value="0" />
                                                            <Setter Property="Padding" Value="6,2,8,2" />
                                                            <Setter Property="FontSize" Value="12" />
                                                            <Setter Property="TextAlignment" Value="Right" />
                                                            <Setter Property="CornerRadius" Value="2" />
                                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                                        </Style>
                                                    </StackPanel.Styles>
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Classes="axis" Text="Пауза после предмета" />
                                                        <TextBox x:Name="SellItemValueBox"
                                                                 Grid.Column="1"
                                                                 Classes="compact"
                                                                 Text="150"
                                                                 AutomationProperties.AutomationId="SellItemValueBox" />
                                                    </Grid>
                                                    <Slider x:Name="SellItemSlider"
                                                            Minimum="0"
                                                            Maximum="1000"
                                                            Value="150"
                                                            SmallChange="15"
                                                            LargeChange="60"
                                                            Height="38"
                                                            VerticalAlignment="Center" />
                                                </StackPanel>

                                                <TextBlock Classes="hint"
                                                           TextWrapping="Wrap"
                                                           Text="Шаг ползунка — 15 мс, значения можно ввести вручную. Ниже ~100 мс на предмет клики игры могут теряться." />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Border>

                                <Border Classes="chapterTab gold"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Margin="18,0,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Path Data="M4,0 L8,4 L4,8 L0,4 Z" Width="8" Height="8" Stretch="Fill" Fill="{StaticResource AncientGoldBrush}" VerticalAlignment="Center" />
                                        <TextBlock Classes="chapterTitle" Text="IV" Foreground="{StaticResource AncientGoldBrush}" />
                                        <TextBlock Classes="chapterTitle" Text="ЗАДЕРЖКИ" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <!-- Status plaque -->
            <Border Grid.Row="2" Classes="statusFrame">
                <Border Classes="statusInner">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="11">
                        <Grid Width="16" Height="16" VerticalAlignment="Center">
                            <Path Data="M8,0 L16,8 L8,16 L0,8 Z"
                                  Width="16" Height="16" Stretch="Fill"
                                  Fill="{Binding Fill, ElementName=StatusDot}"
                                  Opacity="0.18" />
                            <Path x:Name="StatusDot"
                                  Data="M4,0 L8,4 L4,8 L0,4 Z"
                                  Width="8" Height="8" Stretch="Fill"
                                  Fill="{StaticResource TextSecondaryBrush}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock x:Name="StatusText"
                                   Grid.Column="1"
                                   Text="Готово"
                                   FontFamily="{StaticResource BodyFont}"
                                   FontSize="12.5"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <Border Grid.Column="2" Classes="chip" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Path Data="M4,0 L8,4 L4,8 L0,4 Z"
                                      Width="7" Height="7" Stretch="Fill"
                                      Fill="{StaticResource AncientGoldBrush}"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="CONFIG.JSON"
                                           FontFamily="{StaticResource DisplayFont}"
                                           FontSize="9"
                                           LetterSpacing="1.1"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Border>
        </Grid>

        <!-- Экран настроек и обновлений -->
        <Grid x:Name="SettingsPanel"
              RowDefinitions="Auto,*,Auto"
              Margin="30,25,30,22"
              RowSpacing="16"
              IsVisible="False">
            <!-- Шапка настроек -->
            <StackPanel Grid.Row="0" Spacing="17">
                <Grid ColumnDefinitions="Auto,*,Auto"
                      ColumnSpacing="14"
                      Background="Transparent"
                      PointerPressed="OnTitleBarPointerPressed">
                    <Button x:Name="SettingsBackButton"
                            Classes="outline"
                            Padding="13,8"
                            VerticalAlignment="Center"
                            Click="OnSettingsBackClick"
                            ToolTip.Tip="Вернуться на главный экран">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Path Data="M14,6 L2,6 M2,6 L7,1 M2,6 L7,11"
                                  Stroke="{StaticResource AncientGoldBrush}"
                                  StrokeThickness="1.6"
                                  Width="14" Height="12"
                                  Stretch="None"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="НАЗАД"
                                       FontFamily="{StaticResource DisplayFont}"
                                       FontSize="11"
                                       LetterSpacing="1.2"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center" Margin="4,0,0,0">
                        <TextBlock Classes="h1" Text="НАСТРОЙКИ" FontSize="20" />
                        <TextBlock Classes="subtitle" Text="Обновления и информация о сборке" />
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="6"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top">
                        <Button Classes="window"
                                Click="OnMinimizeClick"
                                ToolTip.Tip="Свернуть в трей">
                            <Path Data="M0,6 L12,6"
                                  Stroke="{StaticResource AncientGoldBrush}"
                                  StrokeThickness="1.5"
                                  Width="12" Height="12"
                                  Stretch="None"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Button>
                        <Button Classes="window close"
                                Click="OnCloseClick"
                                ToolTip.Tip="Закрыть">
                            <Path Data="M1,1 L11,11 M11,1 L1,11"
                                  Stroke="{StaticResource AncientGoldBrush}"
                                  StrokeThickness="1.5"
                                  Width="12" Height="12"
                                  Stretch="None"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Декоративный разделитель как на главном экране -->
                <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="11">
                    <Border Height="1"
                            Background="{StaticResource GoldRuleLeftBrush}"
                            VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Path Data="M0,4 L7,0 L14,4 L7,8 Z"
                              Width="14" Height="8" Stretch="Fill"
                              Fill="{StaticResource AncientGoldBrush}"
                              Opacity="0.45" />
                        <Path Data="M6,0 L12,6 L6,12 L0,6 Z"
                              Width="12" Height="12" Stretch="Fill"
                              Fill="{StaticResource AncientGoldBrush}" />
                        <Path Data="M0,4 L7,0 L14,4 L7,8 Z"
                              Width="14" Height="8" Stretch="Fill"
                              Fill="{StaticResource AncientGoldBrush}"
                              Opacity="0.45" />
                    </StackPanel>
                    <Border Grid.Column="2"
                            Height="1"
                            Background="{StaticResource GoldRuleRightBrush}"
                            VerticalAlignment="Center" />
                </Grid>
            </StackPanel>

            <!-- Контент настроек -->
            <ScrollViewer Grid.Row="1"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Hidden">
                <StackPanel Spacing="19" Margin="0,6,0,0">
                    <!-- Карточка I. Центр обновлений -->
                    <Grid>
                        <Border Classes="cardFrame" Margin="0,16,0,0">
                            <Border Classes="cardInner">
                                <Grid>
                                    <!-- Угловые засечки -->
                                    <Border Width="13" Height="13" BorderBrush="{StaticResource AncientGoldBrush}" BorderThickness="1,1,0,0" Opacity="0.4" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                    <Border Width="13" Height="13" BorderBrush="{StaticResource AncientGoldBrush}" BorderThickness="0,1,1,0" Opacity="0.4" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                    <Border Width="13" Height="13" BorderBrush="{StaticResource AncientGoldBrush}" BorderThickness="1,0,0,1" Opacity="0.4" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                                    <Border Width="13" Height="13" BorderBrush="{StaticResource AncientGoldBrush}" BorderThickness="0,0,1,1" Opacity="0.4" HorizontalAlignment="Right" VerticalAlignment="Bottom" />

                                    <StackPanel Margin="22,28,22,20" Spacing="15">
                                        <!-- Главная строка: иконка, описание и кнопка "Проверить сейчас" -->
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                            <Border Width="42" Height="42"
                                                    CornerRadius="21"
                                                    Background="{StaticResource ObsidianBlackBrush}"
                                                    BorderBrush="{StaticResource AncientGoldBorderFaintBrush}"
                                                    BorderThickness="1"
                                                    VerticalAlignment="Center">
                                                <Viewbox Width="18" Height="18"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Data="M12,3 L12,15 M7.5,10.5 L12,15 L16.5,10.5 M4,17 L4,19 C4,20.1 4.9,21 6,21 L18,21 C19.1,21 20,20.1 20,19 L20,17"
                                                              Stroke="{StaticResource AncientGoldBrush}"
                                                              StrokeThickness="2"
                                                              StrokeLineCap="Round"
                                                              StrokeJoin="Round" />
                                                    </Canvas>
                                                </Viewbox>
                                            </Border>

                                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                                <TextBlock Classes="label"
                                                           FontSize="14"
                                                           Text="Проверить обновления" />
                                                <TextBlock Classes="hint"
                                                           Text="Поиск новых релизов на GitHub" />
                                            </StackPanel>

                                            <Button x:Name="CheckUpdatesButton"
                                                    Grid.Column="2"
                                                    Classes="outline"
                                                    Content="Проверить сейчас"
                                                    Padding="16,9"
                                                    VerticalAlignment="Center"
                                                    Click="OnCheckUpdatesClick" />
                                        </Grid>

                                        <Border Height="1" Background="{StaticResource CardInnerBorderBrush}" />

                                        <!-- Индикатор статуса обновления и ProgressBar -->
                                        <Border Background="{StaticResource ObsidianDeepBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="3"
                                                Padding="13,10">
                                            <StackPanel Spacing="10">
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="11">
                                                    <Grid Width="14" Height="14" VerticalAlignment="Center">
                                                        <Path Data="M7,0 L14,7 L7,14 L0,7 Z"
                                                              Width="14" Height="14" Stretch="Fill"
                                                              Fill="{Binding Foreground, ElementName=UpdateStatusText}"
                                                              Opacity="0.2" />
                                                        <Path Data="M4,0 L8,4 L4,8 L0,4 Z"
                                                              Width="7" Height="7" Stretch="Fill"
                                                              Fill="{Binding Foreground, ElementName=UpdateStatusText}"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                                    </Grid>
                                                    <TextBlock x:Name="UpdateStatusText"
                                                               Grid.Column="1"
                                                               Classes="hint"
                                                               TextWrapping="Wrap"
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               Text="При запуске программа только проверяет наличие новой версии и показывает уведомление сверху окна. Скачивание и установка — только по вашему подтверждению." />
                                                    <TextBlock x:Name="UpdatePercentText"
                                                               Grid.Column="2"
                                                               FontFamily="{StaticResource DisplayFont}"
                                                               FontSize="11.5"
                                                               Foreground="{StaticResource AncientGoldBrush}"
                                                               VerticalAlignment="Center"
                                                               IsVisible="False"
                                                               Text="0%" />
                                                </Grid>

                                                <ProgressBar x:Name="UpdateProgressBar"
                                                             Minimum="0"
                                                             Maximum="100"
                                                             Value="0"
                                                             Height="8"
                                                             CornerRadius="2"
                                                             Background="{StaticResource ObsidianBlackBrush}"
                                                             BorderBrush="{StaticResource AncientGoldBorderFaintBrush}"
                                                             BorderThickness="1"
                                                             Foreground="{StaticResource AncientGoldBrush}"
                                                             IsVisible="False" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Border>

                        <Border Classes="chapterTab gold"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Margin="18,0,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Path Data="M4,0 L8,4 L4,8 L0,4 Z" Width="8" Height="8" Stretch="Fill" Fill="{StaticResource AncientGoldBrush}" VerticalAlignment="Center" />
                                <TextBlock Classes="chapterTitle" Text="I" Foreground="{StaticResource AncientGoldBrush}" />
                                <TextBlock Classes="chapterTitle" Text="ЦЕНТР ОБНОВЛЕНИЙ" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- Нижняя плашка: Версия слева + бейдж автообновления справа -->
            <Border Grid.Row="2" Classes="statusFrame">
                <Border Classes="statusInner">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="11">
                        <Grid Width="16" Height="16" VerticalAlignment="Center">
                            <Path Data="M8,0 L16,8 L8,16 L0,8 Z"
                                  Width="16" Height="16" Stretch="Fill"
                                  Fill="{StaticResource AncientGoldBrush}"
                                  Opacity="0.18" />
                            <Path Data="M4,0 L8,4 L4,8 L0,4 Z"
                                  Width="8" Height="8" Stretch="Fill"
                                  Fill="{StaticResource AncientGoldBrush}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock x:Name="SettingsVersionText"
                                   Grid.Column="1"
                                   Text="Версия: 0.0.0"
                                   FontFamily="{StaticResource BodyFont}"
                                   FontSize="12.5"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />

                        <Border Grid.Column="2" Classes="chip" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Path Data="M4,0 L8,4 L4,8 L0,4 Z"
                                      Width="7" Height="7" Stretch="Fill"
                                      Fill="{StaticResource EssenceCyanBrush}"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="GITHUB RELEASES"
                                           FontFamily="{StaticResource DisplayFont}"
                                           FontSize="9"
                                           LetterSpacing="1.1"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Border>
        </Grid>
    </Grid>
</Window>
